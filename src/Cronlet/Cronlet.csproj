<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Cronlet</AssemblyName>
    <Version>0.2.3</Version>
    <RootNamespace>HiroMuraki.Cronlet</RootNamespace>
    <ApplicationIcon>runner.ico</ApplicationIcon>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="Cronlet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="DotTray" Version="3.0.0" />
    <PackageReference Include="Tomlyn" Version="2.11.0" />
  </ItemGroup>

</Project>
